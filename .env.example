# ── App ──────────────────────────────────────────────
# APP_ENV: "local" for development, "production" for deploy.
# APP_DEBUG: "true" shows errors in the browser; "false" hides them.
#   In production, ALWAYS set APP_DEBUG=false.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://message-jar.test

# ── Database ─────────────────────────────────────────
# Local dev with Laragon: user is "root", password is empty.
# Production (InfinityFree): use the DB credentials from the
# control panel. Never reuse local credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=message_jar
DB_USER=root
DB_PASS=

# ── Session ──────────────────────────────────────────
# Session cookie name and lifetime in seconds.
# 2592000 = 30 days.
SESSION_NAME=mj_session
SESSION_LIFETIME=2592000

# ── ImageKit ─────────────────────────────────────────
# Your public URL endpoint (NOT a secret). Example:
#   https://ik.imagekit.io/your-endpoint
# Leave blank in development if you don't have one yet.
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=public_XXXXXXXXXXXXXXXX
IMAGEKIT_PRIVATE_KEY=private_XXXXXXXXXXXXXXXX
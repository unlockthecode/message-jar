# ── Environment & secrets ──────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Logs ───────────────────────────────────────────────
logs/*.log
logs/*.log.*
*.log

# ── Dependencies ───────────────────────────────────────
/vendor/
composer.lock

# ── IDE / editors ──────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

